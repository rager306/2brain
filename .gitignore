# Build output and dependency trees never belong in the monorepo.
/target/
node_modules/
**/target/
**/node_modules/
.env
.env.*
!.env.example
__pycache__/
*.pyc
*.sock
*.pid
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
coverage/
.DS_Store

# Local agent tooling and harness state.
/.prime/

# The one shared target directory (see .cargo/config.toml).
/.cargo-target/

# repowise: the decisions manifest is meant to be committed
!/.repowise/
/.repowise/*
!/.repowise/decisions.yaml

# repowise's own editor scaffolding is generated per machine and carries this
# host's absolute path in .vscode/mcp.json, so it stays out of the repository.
# The decisions manifest IS tracked (see the repowise block above): it is the
# source of truth, and the index beside it is a cache.
/.claude/
/.vscode/
/.github/copilot-instructions.md
